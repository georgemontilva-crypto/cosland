# --- Obligatorias ---
DATABASE_URL=mysql://usuario:clave@host:3306/cosland
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# --- Recomendadas ---
# El correo que se registre con esta dirección queda como administrador
ADMIN_EMAIL=
# URL pública del sitio (para enlaces compartidos)
PUBLIC_URL=http://localhost:3000

# --- Imágenes en Cloudflare R2 (si se dejan vacías, se guardan en ./uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- App Android (Play Store) ---
# Huellas SHA-256 de las llaves de firma, separadas por coma (la tuya y la de Play Console)
ANDROID_SHA256=
ANDROID_PACKAGE=com.cosland.app

# --- Páginas legales ---
# Correo de contacto que aparece en Privacidad y Términos
CONTACT_EMAIL=
